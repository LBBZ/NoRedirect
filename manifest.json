{
  "manifest_version": 3,
  "name": "NoRedirect",
  "version": "0.1.0",
  "description": "Blocks deceptive overlays and unauthorized browser redirects.",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.chaseherbalpasty.com/*",
    "*://*.displayvertising.com/*",
    "*://*.wpadmngr.com/*",
    "*://*.adsco.re/*",
    "*://*.nawpush.com/*",
    "*://*.capndr.com/*",
    "*://*.wpushsdk.com/*",
    "*://*.bookmsg.com/*",
    "*://*.goodimpressioncrboost.com/*",
    "*://*.avalanchetremorunfilled.com/*",
    "*://*.drabimprovement.com/*",
    "*://*.zhhlbgtwrulfi.com/*",
    "*://*.queniuqe.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NoRedirect"
  }
}
